              "shortDescription": {
                "text": "Secret passed to third-party action"
              },
              "fullDescription": {
                "text": "A credential reaches a third-party action input or step scope; third-party does not imply malicious."
              },
              "help": {
                "text": "A credential reaches a third-party action input or step scope; third-party does not imply malicious.",
                "markdown": "**CRD204 — Secret passed to third-party action**\n\nA credential reaches a third-party action input or step scope; third-party does not imply malicious."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
